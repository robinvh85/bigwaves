# Copy to .env (dev) or /etc/bigwaves/env (server). Never commit real values.
# The server file is read by systemd EnvironmentFile: no quotes, no trailing "# comments" on a value
# line (setup-debian.sh rewrites the lines below that have one).
APP_ENV=development            # production on the server
HTTP_ADDR=:8080
APP_URL=http://localhost:5173  # public origin, e.g. https://wavetrade.top:3333
DB_PATH=data/bigwaves.db
LOG_LEVEL=info

# Safety switches. Keep TRADING_ENABLED=false until cutover (see .claude/plans/03-migration-cutover.md).
TRADING_ENABLED=false
SCHEDULER_ENABLED=true

# Dev only: sign in as this user without Auth0. Rejected when APP_ENV=production.
DEV_USER_EMAIL=

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
SESSION_TTL=720h

BINANCE_BASE_URL=https://api-gcp.binance.com
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

DISCORD_ORDER_WEBHOOK=
DISCORD_ALERT_WEBHOOK=
DISCORD_REPORT_WEBHOOK=
DISCORD_CROSS_WEBHOOK=

SENTRY_DSN=
EMA1D_API_TOKEN=
